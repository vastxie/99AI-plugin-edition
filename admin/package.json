{
  "name": "99ai-plugin-edition-admin",
  "type": "module",
  "version": "1.0.0",
  "description": "Administration console for 99AI Plugin Edition",
  "author": "vastxie",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:test": "vue-tsc && vite build --mode test",
    "serve": "http-server ./dist -o",
    "serve:test": "http-server ./dist-test -o",
    "svgo": "svgo -f src/assets/icons",
    "new": "plop",
    "generate:icons": "esno ./scripts/generate.icons.ts",
    "lint": "vue-tsc",
    "format": "prettier --write '{src,scripts,config}/**/*.{vue,ts,tsx,js,jsx,css,scss,less,json,md,html,yml,yaml}' '*.{js,ts,json,md,yml}'",
    "format:check": "prettier --check '{src,scripts,config}/**/*.{vue,ts,tsx,js,jsx,css,scss,less,json,md,html,yml,yaml}' '*.{js,ts,json,md,yml}'",
    "commit": "git cz",
    "release": "bumpp"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@headlessui/vue": "^1.7.23",
    "@imengyu/vue3-context-menu": "^1.5.2",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.18",
    "dompurify": "^3.4.2",
    "echarts": "^6.0.0",
    "fast-glob": "^3.3.3",
    "floating-vue": "5.2.2",
    "hotkeys-js": "^3.13.15",
    "lodash-es": "^4.17.21",
    "marked": "^16.2.1",
    "md-editor-v3": "^5.8.4",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "overlayscrollbars": "^2.12.0",
    "overlayscrollbars-vue": "^0.5.9",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.3.0",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "resize-observer-polyfill": "^1.5.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.21",
    "vue-m-message": "^4.0.2",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.381",
    "@iconify/vue": "^5.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.3.1",
    "@types/path-browserify": "^1.0.3",
    "@unocss/core": "66.5.0",
    "@unocss/preset-mini": "66.5.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "boxen": "^8.0.1",
    "bumpp": "^10.2.3",
    "element-plus": "^2.11.1",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.1",
    "http-server": "^14.1.1",
    "inquirer": "^12.9.4",
    "msw": "^2.11.1",
    "picocolors": "^1.1.1",
    "plop": "^4.0.2",
    "sass": "^1.102.0",
    "svgo": "^4.0.2",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "unocss": "66.5.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-turbo-console": "^2.2.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^6.4.3",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-compression2": "^2.2.1",
    "vite-plugin-fake-server": "^2.2.0",
    "vite-plugin-pages": "^0.33.1",
    "vite-plugin-svg-sprite": "^0.7.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vite-plugin-vue-meta-layouts": "^0.6.0",
    "vue-tsc": "^3.0.6"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
