{
  "name": "99ai-plugin-edition-service",
  "version": "1.0.0",
  "description": "Backend service for 99AI Plugin Edition",
  "author": "vastxie",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "nest build",
    "build:test": "nest build",
    "test": "node scripts/run-jest.js",
    "test:cov": "node scripts/run-jest.js --coverage",
    "format": "prettier --write 'src/**/*.{vue,ts,tsx,js,jsx,css,scss,less}'",
    "format:check": "prettier --check 'src/**/*.{vue,ts,tsx,js,jsx,css,scss,less}'",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@aws-sdk/client-s3": "^3.882.0",
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.20",
    "@opendocsg/pdf2md": "^0.2.5",
    "@types/raw-body": "^2.3.0",
    "ali-oss": "^6.23.0",
    "alipay-sdk": "^4.14.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.2.5",
    "form-data": "^4.0.6",
    "gpt-tokenizer": "^2.9.0",
    "guid-typescript": "^1.0.9",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.7.0",
    "jschardet": "^3.1.4",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "mammoth": "^1.10.0",
    "mime-types": "^2.1.35",
    "mysql2": "^3.14.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "openai": "^4.104.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "path-to-regexp": "^1.9.0",
    "pptxtojson": "^1.6.0",
    "punycode": "npm:punycode.js@2.3.1",
    "punycode.js": "2.3.1",
    "raw-body": "^3.0.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "stream-to-buffer": "^0.1.0",
    "stripe": "^18.5.0",
    "turndown": "^7.2.2",
    "typeorm": "^0.3.26",
    "uuid": "^9.0.1",
    "wechatpay-node-v3": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.23",
    "@types/node": "22.20.1",
    "@types/turndown": "^5.0.6",
    "fs-extra": "^11.3.1",
    "jest": "29.3.1",
    "prettier": "^2.8.8",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
