# HTTP
PORT=9520
ISDEV=false
ADMIN_SERVE_ROOT=/admin
REQUEST_BODY_LIMIT=50mb
# 生产环境必填，多个允许来源用逗号分隔。
CORS_ORIGINS=https://example.com

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chatgpt
DB_PASS=replace-with-a-strong-database-password
DB_DATABASE=chatgpt
# 默认为 false；仅空数据库首次建表时临时改为 true，完成后立即恢复 false。
DB_SYNC=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_USER=
REDIS_DB=0

# 仅在数据库不存在 super 用户时使用。密码不会写入日志。
INITIAL_ADMIN_USERNAME=super
INITIAL_ADMIN_PASSWORD=CHANGE_ME_REQUIRED
INITIAL_ADMIN_EMAIL=admin@localhost.invalid

# MCP 默认仅 super 可调用。普通角色需要同时命中角色与 client/tool 白名单。
MCP_TOOL_ALLOWED_ROLES=
MCP_TOOL_ALLOWLIST=

# 可选命名空间，用于隔离同一 Redis 中的多个部署。
NAMESPACE=99AIPlugin
