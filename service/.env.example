# HTTP
PORT=9520
ISDEV=false
ADMIN_SERVE_ROOT=/admin
REQUEST_BODY_LIMIT=50mb
# 生产环境必填，多个允许来源用逗号分隔。
CORS_ORIGINS=https://example.com
# 可选。支付回调基址（代码默认 http://localhost:9520）。生产支付须改为公网 HTTPS。
API_URL=http://127.0.0.1:9520
# 可选。支付完成后的用户端跳转。开发时 chat Vite 监听 9002；整合部署与站点同域时用 9520。
CLIENT_URL=http://127.0.0.1:9520

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chatgpt
DB_PASS=replace-with-a-strong-database-password
DB_DATABASE=chatgpt
# 默认为 false；仅空数据库首次建表时临时改为 true，完成后立即恢复 false。
DB_SYNC=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_USER=
REDIS_DB=0

# 仅在数据库不存在 super 用户时使用。密码不会写入日志。
INITIAL_ADMIN_USERNAME=super
# 必填：至少 12 位独立强密码。CHANGE_ME_REQUIRED、changeme 等占位符会被拒绝。
# 留空时 docker compose 会在启动前失败，避免带着无效密码拉起容器。
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@localhost.invalid

# MCP 默认仅 super 可调用。普通角色需要同时命中角色与 client/tool 白名单。
MCP_TOOL_ALLOWED_ROLES=
MCP_TOOL_ALLOWLIST=

# 可选命名空间，用于隔离同一 Redis 中的多个部署。
NAMESPACE=99AIPlugin
